{
  "name": "momos-motion",
  "version": "1.0.0",
  "private": true,
  "description": "Programmatic marketing videos for Momos, built with Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render MomosPromo out/momos-promo.mp4",
    "render:square": "remotion render MomosPromoSquare out/momos-promo-square.mp4",
    "still": "remotion still MomosPromo out/thumbnail.png --frame=60",
    "typecheck": "tsc --noEmit",
    "render:alfie": "remotion render AlfieLaunch out/alfie-launch.mp4 --crf=18",
    "render:alfie-vertical": "remotion render AlfieLaunchVertical out/alfie-launch-vertical.mp4 --crf=18",
    "render:arrowsterr": "remotion render ArrowsterrLaunch out/arrowsterr-launch.mp4 --crf=18",
    "render:arrowsterr-vertical": "remotion render ArrowsterrLaunchVertical out/arrowsterr-launch-vertical.mp4 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/effects": "4.0.536",
    "@remotion/fonts": "4.0.536",
    "@remotion/layout-utils": "4.0.536",
    "@remotion/media": "4.0.536",
    "@remotion/motion-blur": "4.0.536",
    "@remotion/noise": "4.0.536",
    "@remotion/paths": "4.0.536",
    "@remotion/rough-notation": "4.0.536",
    "@remotion/shapes": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "@remotion/zod-types": "4.0.536",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.536",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
